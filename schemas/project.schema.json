{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTKit Project Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roots", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "stack"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "stack": { "enum": ["go", "node", "ts", "python", "rust", "java", "cpp", "dotnet", "generic"] },
          "packageManager": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "executable", "argv", "cwd", "timeoutSec"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "kind": { "enum": ["test", "lint", "typecheck", "format", "build", "custom"] },
          "executable": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "allowEnv": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } },
          "mutatesFiles": { "type": "boolean" }
        }
      }
    },
    "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "generatedDirs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "summary"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
