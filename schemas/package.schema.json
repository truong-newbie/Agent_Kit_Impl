{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTKit Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "runtimeTargets",
    "scopes",
    "requiresCapabilities",
    "packageDependencies",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 32 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "description": { "type": "string", "minLength": 1 },
    "runtimeTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "gemini", "opencode", "cursor"] }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["project", "global"] }
    },
    "requiresCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["instructions", "skills"] }
    },
    "packageDependencies": {
      "type": "array",
      "maxItems": 0
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "requires"],
        "properties": {
          "id": { "type": "string", "pattern": "^(skill|rule|workflow|template)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["skill", "rule", "workflow", "template"] },
          "source": { "type": "string", "minLength": 1 },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
